GCC_TREAT_INCOMPATIBLE_POINTER_TYPE_WARNINGS_AS_ERRORS = YES
GCC_TREAT_WARNINGS_AS_ERRORS = YES
MTL_TREAT_WARNINGS_AS_ERRORS = YES
OTHER_SWIFT_FLAGS = $(inherited) -warnings-as-errors

// The upstream product name remains the default. OpenCSV's TestFlight archive
// overrides this value without renaming targets or executables.
OPENCSV_APP_DISPLAY_NAME = Signal
OPENCSV_APP_MARKETING_VERSION = 8.23
OPENCSV_APP_BUILD_NUMBER = 0
OPENCSV_SOURCE_COMMIT = development
OPENCSV_DISTRIBUTION_NETWORK = development
OPENCSV_PRODUCT_DEPLOYMENT = development

// User-specific overrides
#include? "User.xcconfig"
